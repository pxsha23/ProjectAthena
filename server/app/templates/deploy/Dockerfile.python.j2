# Generated by Athena's Deployment Agent.
# Builds a small image that runs the {{ d.backend_framework or "Python" }} backend.
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Install dependencies first so this layer is cached between code changes.
COPY {{ join(d.backend_dir, "requirements.txt") }} .
RUN pip install --no-cache-dir -r requirements.txt

COPY {{ d.backend_dir or "." }}/ .

EXPOSE 8000
{% if d.backend_framework == "fastapi" %}
CMD ["uvicorn", "{{ d.python_entry_module or 'main:app' }}", "--host", "0.0.0.0", "--port", "8000"]
{% elif d.backend_framework == "flask" %}
# Needs gunicorn in requirements.txt.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "{{ d.python_entry_module or 'main:app' }}"]
{% elif d.backend_framework == "django" %}
# Needs gunicorn in requirements.txt. Replace "config" with your Django project package.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "config.wsgi:application"]
{% else %}
CMD ["python", "main.py"]
{% endif %}
