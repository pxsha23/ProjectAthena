# Generated by Athena's Deployment Agent.
# Render Blueprint: connect the repository in Render and it creates these services.
services:
{% if d.backend_language != "none" %}
  - type: web
    name: api
    runtime: docker
    plan: free
    dockerfilePath: ./Dockerfile
{% if d.backend_framework == "fastapi" %}
    healthCheckPath: /docs
{% endif %}
{% if d.database == "postgresql" %}
    envVars:
      - key: DATABASE_URL
        fromDatabase:
          name: app-db
          property: connectionString
{% endif %}
{% endif %}
{% if d.frontend_framework %}
  - type: web
    name: frontend
    runtime: static
    rootDir: {{ d.frontend_dir or "." }}
    buildCommand: npm install && npm run build
    staticPublishPath: {{ "out" if d.frontend_framework == "nextjs" else "dist" }}
{% endif %}
{% if d.database == "postgresql" %}

databases:
  - name: app-db
    plan: free
{% endif %}
