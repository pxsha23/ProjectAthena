# Generated by Athena's Deployment Agent.
# Start everything locally with: docker compose up --build
services:
  api:
    build: .
    ports:
      - "8000:8000"
{% if d.database == "postgresql" %}
    environment:
      DATABASE_URL: postgresql://app:app@db:5432/app
    depends_on:
      - db

  db:
    image: postgres:17
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports:
      - "5432:5432"
    volumes:
      - dbdata:/var/lib/postgresql/data

volumes:
  dbdata:
{% elif d.database == "mysql" %}
    environment:
      DATABASE_URL: mysql://app:app@db:3306/app
    depends_on:
      - db

  db:
    image: mysql:8.4
    environment:
      MYSQL_USER: app
      MYSQL_PASSWORD: app
      MYSQL_DATABASE: app
      MYSQL_ROOT_PASSWORD: app
    volumes:
      - dbdata:/var/lib/mysql

volumes:
  dbdata:
{% elif d.database == "mongodb" %}
    environment:
      MONGODB_URL: mongodb://db:27017/app
    depends_on:
      - db

  db:
    image: mongo:8
    volumes:
      - dbdata:/data/db

volumes:
  dbdata:
{% endif %}
