# Generated by Athena's Deployment Agent.
# Checks the project on every push to main, then asks Render to deploy.
name: Deploy

on:
  push:
    branches: [main]

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if d.backend_language == "python" %}
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install backend dependencies
        run: pip install -r {{ join(d.backend_dir, "requirements.txt") }}
      - name: Compile backend
        run: python -m compileall -q {{ d.backend_dir or "." }}
{% endif %}
{% if d.backend_language == "node" or d.frontend_framework %}
      - uses: actions/setup-node@v4
        with:
          node-version: 22
{% endif %}
{% if d.backend_language == "node" %}
      - name: Install backend dependencies
        run: npm install
        working-directory: {{ d.backend_dir or "." }}
{% endif %}
{% if d.frontend_framework %}
      - name: Build frontend
        run: npm install && npm run build
        working-directory: {{ d.frontend_dir or "." }}
{% endif %}

  deploy:
    needs: check
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Render deploy
        env:
          HOOK: {% raw %}${{ secrets.RENDER_DEPLOY_HOOK }}{% endraw %}

        run: |
          if [ -z "$HOOK" ]; then
            echo "RENDER_DEPLOY_HOOK is not set; skipping deploy."
            exit 0
          fi
          curl -fsS -X POST "$HOOK"
