# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL + pgvector from docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://athena:athena@localhost:5433/athena
DATABASE_ECHO=false

# --- Auth cookies ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# --- GitHub OAuth (sign in with GitHub + push exports to GitHub) ---
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# --- LLM: Anthropic ("api") ---
ANTHROPIC_API_KEY=
# Model name from the Anthropic model list.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=16000
# If the model declines a request, the API retries it on a fallback model inside the same call.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- LLM: Ollama ("local") ---
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled, for example: ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=
# CPU-only machines are slow; the Code Agent can take many minutes.
OLLAMA_TIMEOUT_SECONDS=1800
# Context window in tokens. Ollama's default is small and silently cuts long prompts.
OLLAMA_NUM_CTX=16384
# Maximum tokens per answer.
OLLAMA_MAX_TOKENS=8192
OLLAMA_KEEP_ALIVE=30m

# --- LLM: Groq ("groq"): hosted open models, free tier with rate limits ---
# Free key: https://console.groq.com/keys   Model example: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_TOKENS=6000
# gpt-oss models only: low | medium | high. Low keeps rate-limit use down.
GROQ_REASONING_EFFORT=low

# --- Which provider each agent uses: api | local | groq | fake ---
# "fake" returns built-in sample output: no key needed, useful for demos and frontend work.
AGENT_IDEA_PROVIDER=api
AGENT_STACK_PROVIDER=api
AGENT_CODE_PROVIDER=api
AGENT_SUMMARY_PROVIDER=api
AGENT_EVA_PROVIDER=api
AGENT_CHAT_PROVIDER=api

# Optional per-agent model overrides (leave empty to use ANTHROPIC_MODEL / OLLAMA_MODEL).
AGENT_IDEA_MODEL=
AGENT_STACK_MODEL=
AGENT_CODE_MODEL=
AGENT_SUMMARY_MODEL=
AGENT_EVA_MODEL=
AGENT_CHAT_MODEL=

# Retries after an agent returns output that fails schema validation.
AGENT_MAX_RETRIES=2

# --- Code search embeddings ---
# sentence-transformers (needs: uv pip install -e ".[embeddings]") or hash (no dependencies, lower quality)
EMBEDDINGS_BACKEND=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model's output size and the migration (384 for all-MiniLM-L6-v2).
EMBEDDING_DIM=384
